{
    "configurations": [
        {
            "name": "STM32",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/STM32_Firmware/Core/Inc",
                "${workspaceFolder}/STM32_Firmware/App/Inc",
                "${workspaceFolder}/STM32_Firmware/Board/Inc",
                "${workspaceFolder}/STM32_Firmware/Drivers/STM32F1xx_HAL_Driver/Inc",
                "${workspaceFolder}/STM32_Firmware/Drivers/STM32F1xx_HAL_Driver/Inc/Legacy",
                "${workspaceFolder}/STM32_Firmware/Drivers/CMSIS/Device/ST/STM32F1xx/Include",
                "${workspaceFolder}/STM32_Firmware/Drivers/CMSIS/Include",
                "/usr/lib/gcc/arm-none-eabi/10.3.1/include",
                "/usr/lib/gcc/arm-none-eabi/10.3.1/include-fixed",
                "/usr/lib/arm-none-eabi/include"
            ],
            "defines": [
                "USE_HAL_DRIVER",
                "STM32F103xB"
            ],
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-arm",
            "compileCommands": "${workspaceFolder}/STM32_Firmware/build/compile_commands.json"
        }
    ],
    "version": 4
}